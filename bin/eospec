#!/bin/sh
# eospec — openspec, extended: focus, approve, close. Everything else
# execs openspec verbatim. Plain JS beneath: node refuses type-stripping
# under node_modules, so installed bins must not be TypeScript. npm links
# global bins as symlinks — resolve $0 first (fallback keeps direct
# repo invocations working).
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
exec node "$(dirname "$SELF")/eospec.js" "$@"
