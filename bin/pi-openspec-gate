#!/bin/sh
# pi-openspec-gate — human-terminal approval surface (shim).
# The real logic lives in pi-openspec-gate.ts; the shim keeps the
# extensionless entry point (Node needs the .ts extension for type
# stripping, and the gate's approval-touch pattern matches this name).
exec node --experimental-strip-types "$(dirname "$0")/pi-openspec-gate.ts" "$@"
