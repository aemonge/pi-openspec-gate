#!/bin/sh
# pios-gate — the gate as an openspec feature extension (shim).
# Own verbs: approve, confirm, pending. Everything else execs openspec
# verbatim. The real logic lives in pios-gate.ts; the shim keeps the
# extensionless entry point (Node needs the .ts extension for type
# stripping, and the gate's approval-touch pattern matches these names).
exec node --experimental-strip-types "$(dirname "$0")/pios-gate.ts" "$@"
