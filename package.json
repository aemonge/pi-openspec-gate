{
  "name": "@aemonge-dev/pi-openspec-gate",
  "version": "1.1.0",
  "description": "pi-openspec-gate — openspec, extended. Three human verbs (focus, approve, close) over openspec's new/archive via the eospec CLI, plus a Pi extension that accounts every mutating tool call: allowed by path, attributed to the aimed change, declared by the human, or refused with instructions.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "openspec",
    "eospec",
    "accounting"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "src",
    "bin",
    "example",
    "config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "justfile"
  ],
  "bin": {
    "eospec": "bin/eospec"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aemonge/eospec.git"
  },
  "bugs": {
    "url": "https://github.com/aemonge/eospec/issues"
  },
  "homepage": "https://github.com/aemonge/eospec#readme"
}
