{
  "name": "@aemonge-dev/pi-openspec-gate",
  "version": "0.1.0",
  "description": "Ladder gate for Pi: accounting at the tool-call boundary — every mutation is exempt-recorded, attributed to a focused change, declared by the human, or blocked with remedies. Never permission; never a renderer.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "openspec",
    "ladder",
    "accounting"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "src",
    "config.json",
    "README.md",
    "LICENSE",
    "justfile"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aemonge/pi-openspec-gate.git"
  },
  "bugs": {
    "url": "https://github.com/aemonge/pi-openspec-gate/issues"
